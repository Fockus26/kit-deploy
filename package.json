{
  "name": "kit-deploy",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "qa:local": "node scripts/qa-local.ts",
    "shots:publish": "bash scripts/publish-pr-shots.sh .pr-shots",
    "test:related": "bun scripts/test-related.ts",
    "test": "bun test ./tests/unit --dots --pass-with-no-tests",
    "build:agent": "bun build --compile --target=bun-linux-x64 agent/main.ts --outfile build/kit-agent",
    "build:cli": "bun build --compile --target=bun-linux-x64 cli/main.ts --outfile build/kit-deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts drizzle",
    "test:infra": "bash infra/test/server-ready.test.sh",
    "test:infra:install": "bash infra/test/install.test.sh",
    "test:infra:previews": "bash infra/test/previews.test.sh",
    "release": "bash scripts/release.sh",
    "shots": "node scripts/pr-screenshots.ts .pr-shots.json",
    "context:backup": "bash scripts/context-backup.sh",
    "context:restore": "bash scripts/context-backup.sh --restore"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.23",
    "better-auth": "1.7.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.4.2",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
